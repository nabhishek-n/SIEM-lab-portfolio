alert icmp any any -> any any (
    msg:"LOCAL ICMP Ping Detected";
    sid:1000001;
    rev:2;
)

alert tcp any any -> any 22 (
    msg:"LOCAL SSH Connection Attempt Detected";
    flags:S;
    flow:stateless;
    sid:1000003;
    rev:2;
)

alert tcp any any -> any 80 (
    msg:"LOCAL HTTP Connection Attempt Detected";
    flags:S;
    flow:stateless;
    sid:1000004;
    rev:2;
)
